# Copy to .env and fill in. Never commit .env.

# Shared secret the Android app sends as the X-API-Key header (min 16 chars).
# Generate one: uv run python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=

# Which LLM API writes suggestions: anthropic or openai (needed from Phase 4).
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Model for drafting replies (e.g. claude-sonnet-5-5, or gpt-4o-mini with openai).
LLM_MODEL=claude-sonnet-5-5
# Model for the risk check, extraction, summaries (e.g. claude-haiku-5-5 or gpt-4o-mini).
LLM_FAST_MODEL=claude-haiku-5-5
# Local embedding model (fastembed). Multilingual by default.
EMBEDDING_MODEL=intfloat/multilingual-e5-small

# SQLAdmin login (needed from Phase 3).
ADMIN_USER=admin
# bcrypt hash of the admin password: uv run python -m app.cli hash-password
# Keep the single quotes: the hash contains "$" characters.
ADMIN_PASSWORD_HASH=
# Signs the admin session cookie. Generate like API_KEY.
SECRET_KEY=
# Set true when the admin is served over HTTPS, so the session cookie is marked Secure.
ADMIN_HTTPS_ONLY=false

# SQLite file. Leave empty for the default:
#   Windows: %LOCALAPPDATA%\reply-assistant\data.db
#   Linux/macOS: ~/.local/share/reply-assistant/data.db
# DATABASE_URL=sqlite:///C:/path/to/data.db

# IANA timezone of the phone; WhatsApp export times are converted from this to UTC.
TIMEZONE=Asia/Kolkata

LOG_LEVEL=INFO
